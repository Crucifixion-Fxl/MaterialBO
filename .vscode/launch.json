            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "pythonArgs": [],
            "env": {
                "LD_LIBRARY_PATH": "/opt/pub/toolkits/anaconda3/lib:${env:LD_LIBRARY_PATH}"
            },
